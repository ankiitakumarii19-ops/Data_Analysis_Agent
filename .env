# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_JWT_SECRET=

# Get one at https://console.groq.com
GROQ_API_KEY=

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5000

# How long a generated audit report stays available before auto-deleting
AUDIT_RETENTION_HOURS=42

# true only for local development — never enable in production
FLASK_DEBUG=false
